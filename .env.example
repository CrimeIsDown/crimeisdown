# Configure a separate development database; never point local tests at production.
APP_NAME=CrimeIsDown
APP_URL=http://localhost:8000
APP_KEY=
CID_DATABASE_URL=mysql+pymysql://crimeisdown:change-me@localhost:3306/crimeisdown
REDIS_URL=redis://localhost:6379/1
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Provider credentials are optional and must be supplied privately when needed.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=http://localhost:8000/auth/callback

# Fabricated defaults are for tests only; configure the existing provider bindings privately.
CID_MEMBERSHIP_TIERS=
CID_ADMIN_TIER_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
CACHE_BUCKET=
CID_CHANNEL_ID=
NOTIFICATION_CONFIGURATION=

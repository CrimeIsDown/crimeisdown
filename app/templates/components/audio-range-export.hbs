<div class="audio-range-export" {{did-insert this.initialize}}>
  <h4>Range export (Commander+)</h4>
  <p class="text-muted">Combine up to 24 continuous hours into one MP3 file.</p>

  {{#unless this.authReady}}
    <p class="small text-muted">Checking account access...</p>
  {{/unless}}

  {{#if this.authReady}}
    {{#if (not this.session.isAuthenticated)}}
      <div class="alert alert-info" data-test-range-login-cta>
        <p class="mb-2">Log in to use range export.</p>
        <a class="btn btn-primary btn-sm" href="{{this.loginUrl}}" referrerpolicy="unsafe-url">Log in with Patreon</a>
      </div>
    {{else if (not this.canUseRangeExport)}}
      <div class="alert alert-warning" data-test-range-upgrade-cta>
        <p class="mb-2">Range export requires Commander tier ($50/mo) or above.</p>
        <a class="btn btn-primary btn-sm" href="{{this.commanderCheckoutUrl}}" target="_blank" rel="noopener noreferrer">Upgrade to Commander</a>
      </div>
    {{/if}}
  {{/if}}

  <form class="audio-range-export__form" {{on "submit" this.submit}}>
    <div class="mb-3">
      <label for="range-feed">Radio channel</label>
      <select name="feed" id="range-feed" class="form-control" required data-test-range-feed>
        <option value="" disabled selected>Select channel</option>
        {{#each this.feeds as |feed|}}
          <option value={{feed.value}}>{{feed.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="mb-3">
      <label for="range-start-datetime">Start time (US Central)</label>
      <div class="input-group date">
        <EmberFlatpickr
          name="start_datetime"
          @id="range-start-datetime"
          class="form-control"
          @allowInput={{true}}
          @defaultDate={{this.startDate}}
          @date={{this.startDate}}
          @enableTime={{this.startPickerOptions.enableTime}}
          @dateFormat={{this.startPickerOptions.dateFormat}}
          @minuteIncrement={{this.startPickerOptions.minuteIncrement}}
          @onChange={{null}}
        />
        <span class="input-group-text"><FaIcon @icon="calendar" /></span>
      </div>
    </div>

    <div class="mb-3">
      <label for="range-end-datetime">End time (US Central)</label>
      <div class="input-group date">
        <EmberFlatpickr
          name="end_datetime"
          @id="range-end-datetime"
          class="form-control"
          @allowInput={{true}}
          @defaultDate={{this.endDate}}
          @date={{this.endDate}}
          @enableTime={{this.endPickerOptions.enableTime}}
          @dateFormat={{this.endPickerOptions.dateFormat}}
          @minuteIncrement={{this.endPickerOptions.minuteIncrement}}
          @onChange={{null}}
        />
        <span class="input-group-text"><FaIcon @icon="calendar" /></span>
      </div>
    </div>

    <button
      type="submit"
      class="btn btn-primary"
      disabled={{this.submitDisabled}}
      data-test-range-submit
    >
      {{if this.isSubmitting "Submitting..." "Create range export"}}
    </button>
  </form>

  {{#if this.createError}}
    <div class="alert alert-danger mt-3 audio-range-export__message" data-test-range-create-error>
      {{this.createError}}
    </div>
  {{/if}}

  {{#if this.hasJobResult}}
    <div class="card mt-3 audio-range-export__status" data-test-range-status>
      <div class="card-body">
        <p class="mb-2">
          Export status:
          <span class="badge {{this.statusBadgeClass}}" data-test-range-job-status>{{or this.status "queued"}}</span>
        </p>
        <p class="mb-1">Requested hours: {{or this.requestedHours 0}}</p>
        <p class="mb-1">Processed hours: {{or this.processedHours 0}}</p>

        {{#if (and this.missingHours this.missingHours.length)}}
          <div class="audio-range-export__missing mt-2" data-test-range-missing-hours>
            <p class="mb-1"><strong>Missing hours</strong></p>
            <ul class="mb-0">
              {{#each this.missingHours as |hour|}}
                <li>{{hour}}</li>
              {{/each}}
            </ul>
          </div>
        {{/if}}

        {{#if this.downloadUrl}}
          <a
            href="{{this.downloadUrl}}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-success mt-3"
            data-test-range-download
          >
            Download merged audio
          </a>
        {{/if}}

        {{#if this.jobError}}
          <div class="alert alert-danger mt-3 mb-0 audio-range-export__message" data-test-range-job-error>
            {{this.jobError}}
          </div>
        {{/if}}
      </div>
    </div>
  {{/if}}
</div>

---
import "@/styles/global.css";
import "@/styles/legacy.css";
import "@/styles/parity.css";
import Icons from "@/components/layout/Icons.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { buildCanonical, buildTitle } from "@/lib/seo";
import { site } from "@/lib/site";
import { themeStorageKey } from "@/lib/theme";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  mainClass?: string;
};

const {
  title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  noIndex = false,
  mainClass = "site-main",
} = Astro.props;

const canonical = buildCanonical(canonicalPath);
const fullTitle = buildTitle(title);
const bootstrapStylesheet =
  "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css";
const bootstrapScript =
  "https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js";
const googleMapsKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
const googlePlacesScript = googleMapsKey
  ? `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(googleMapsKey)}&loading=async&libraries=places&callback=googleCallback`
  : undefined;
const themeScript = `
(() => {
  const storageKey = ${JSON.stringify(themeStorageKey)};
  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");
  const getStoredTheme = () => {
    try {
      return localStorage.getItem("theme") || localStorage.getItem(storageKey) || "auto";
    } catch {
      return "auto";
    }
  };
  const applyTheme = (theme) => {
    const resolvedTheme = theme === "auto"
      ? media.matches ? "dark" : "light"
      : theme;
    root.dataset.theme = theme;
    root.setAttribute("data-bs-theme", resolvedTheme);
    root.classList.toggle("dark", resolvedTheme === "dark");
  };
  const syncButtons = (theme) => {
    const icon = document.querySelector(".theme-icon-active use");
    icon?.setAttribute("href", "#" + ({light:"sun-fill",dark:"moon-stars-fill",auto:"circle-half"}[theme] || "circle-half"));
    document.querySelectorAll("[data-theme-value]").forEach((button) => {
      const isActive = button.getAttribute("data-theme-value") === theme;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });
  };
  const storedTheme = getStoredTheme();
  applyTheme(storedTheme);
  media.addEventListener?.("change", () => {
    if (getStoredTheme() === "auto") {
      applyTheme("auto");
    }
  });
  document.addEventListener("DOMContentLoaded", () => {
    syncButtons(getStoredTheme());
    document.querySelectorAll("[data-theme-value]").forEach((button) => {
      button.addEventListener("click", () => {
        const theme = button.getAttribute("data-theme-value") || "auto";
        try {
          localStorage.setItem(storageKey, theme);
          localStorage.setItem("theme", theme);
        } catch {}
        applyTheme(theme);
        syncButtons(theme);
      });
    });
    if (getStoredTheme() === "auto") {
      applyTheme("auto");
      syncButtons("auto");
    }
  });
})();
`;
const globalScript = `
try {
  window.googleCallback = window.googleCallback || function () {};
  window.doorbellOptions = {
    appKey: "REDACTED_PUBLIC_CREDENTIAL",
    hideButton: true,
  };
  (function (w, d, t) {
    var hasLoaded = false;
    function l() {
      if (hasLoaded) return;
      hasLoaded = true;
      window.doorbellOptions.windowLoaded = true;
      var g = d.createElement(t);
      g.id = "doorbellScript";
      g.type = "text/javascript";
      g.async = true;
      g.src = "https://embed.doorbell.io/button/0?t=" + new Date().getTime();
      (d.getElementsByTagName("head")[0] || d.getElementsByTagName("body")[0]).appendChild(g);
    }
    if (w.addEventListener) w.addEventListener("load", l, false);
    else if (w.attachEvent) w.attachEvent("onload", l);
    else l();
    if (d.readyState === "complete") l();
  })(window, document, "script");
  (function (h, o, t, j, a, r) {
    h.hj = h.hj || function () { (h.hj.q = h.hj.q || []).push(arguments); };
    h._hjSettings = { hjid: 0, hjsv: 5 };
    a = o.getElementsByTagName("head")[0];
    r = o.createElement("script");
    r.async = 1;
    r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
    a.appendChild(r);
  })(window, document, "//static.hotjar.com/c/hotjar-", ".js?sv=");
  if (window.StereoPannerNode && typeof window.StereoPannerNode.polyfill === "function") {
    window.StereoPannerNode.polyfill();
  }
} catch {}
`;
---

<!doctype html>
<html lang="en" data-theme="auto" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="search" type="application/opensearchdescription+xml" href="https://crimeisdown.com/osd.xml" title="Address search" />
    <link rel="preconnect" href="//maps.googleapis.com" />
    <link rel="preload" href="https://crimeisdown.statuspage.io/embed/script.js" as="script" />
    {googlePlacesScript && <link rel="preload" href={googlePlacesScript} as="script" />}
    <link rel="stylesheet" href={bootstrapStylesheet} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@CrimeIsDown" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@EricTendian" />
    <script is:inline set:html={themeScript}></script>
    {(noIndex || import.meta.env.PUBLIC_PREVIEW === "true") && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class="site-shell">
    <Icons />
    <Header />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer />
    <script is:inline src={bootstrapScript} defer></script>
    <script is:inline src="https://crimeisdown.statuspage.io/embed/script.js" defer></script>
    <script is:inline set:html={globalScript}></script>
    {googlePlacesScript && <script is:inline src={googlePlacesScript} async></script>}
  </body>
</html>

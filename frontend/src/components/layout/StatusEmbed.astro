---
import { buttonVariants } from "@/lib/button-styles";
---

<section class="rounded-[1.75rem] border border-border/70 bg-card/85 p-5 shadow-sm backdrop-blur">
  <div class="space-y-3">
    <div>
      <p class="eyebrow">Live Status</p>
      <h2 class="text-lg font-semibold text-foreground">Infrastructure updates</h2>
    </div>
    <p class="text-sm leading-7 text-muted-foreground">
      Status notices and maintenance events still come from the existing
      Statuspage feed. If the embed does not load, the status site remains the
      source of truth.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="https://status.crimeisdown.com/"
        class:list={[buttonVariants({ variant: "outline" }), "no-underline"]}
        target="_blank"
        rel="noreferrer"
      >
        View latest updates
      </a>
      <a
        href="/support"
        class:list={[buttonVariants({ variant: "ghost" }), "no-underline"]}
      >
        Send feedback
      </a>
    </div>
  </div>
</section>

<script is:inline async src="https://crimeisdown.statuspage.io/embed/script.js"></script>

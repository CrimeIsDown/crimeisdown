---
import { buttonVariants } from "@/lib/button-styles";
import type { AudioStreamGroup } from "@/lib/audio/data";

const { groups } = Astro.props as { groups: AudioStreamGroup[] };
---

<div class="grid gap-6">
  {groups.map((group) => (
    <section class="surface-card rounded-[1.75rem] p-6 sm:p-8">
      <div class="mb-5 space-y-2">
        <h2 class="text-2xl font-semibold text-foreground">{group.title}</h2>
        <p class="text-sm leading-7 text-muted-foreground">{group.description}</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {group.streams.map((stream) => (
          <article class="rounded-[1.4rem] border border-border/70 bg-background/85 p-5 shadow-sm">
            <div class="space-y-3">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-lg font-semibold text-foreground">
                  {stream.shortname ?? stream.name}
                </h3>
                {stream.frequency ? (
                  <span class="data-pill">{stream.frequency}</span>
                ) : null}
              </div>
              <p class="text-sm leading-7 text-muted-foreground">{stream.description}</p>
              <div class="flex flex-wrap gap-2">
                <a
                  class:list={["no-underline", buttonVariants({ variant: "secondary" })]}
                  href={`/audio/live/${stream.slug}`}
                >
                  Open player
                </a>
                {stream.openmhz ? (
                  <a
                    class:list={["no-underline", buttonVariants({ variant: "default" })]}
                    href={stream.openmhz}
                    target="_blank"
                    rel="noreferrer"
                  >
                    OpenMHz
                  </a>
                ) : null}
                {stream.broadcastify ? (
                  <a
                    class:list={["no-underline", buttonVariants({ variant: "outline" })]}
                    href={stream.broadcastify}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Broadcastify
                  </a>
                ) : null}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</div>

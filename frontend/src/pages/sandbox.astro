---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Sandbox" noIndex><div class="container"><form data-sandbox-search><div class="input-group"><input type="search" class="form-control" aria-label="Search" name="query" required /><button class="btn btn-primary">Search</button></div></form></div><script>
document.querySelector("[data-sandbox-search]")!.addEventListener("submit", event => {
 event.preventDefault(); const query = new FormData(event.currentTarget as HTMLFormElement).get("query");
 const index = "calls_" + new Date().toISOString().slice(0,7).replace("-", "_"); const url = new URL("/transcripts/search", location.origin); url.searchParams.set(index + "[query]", String(query || "")); location.assign(url);
});
</script></BaseLayout>

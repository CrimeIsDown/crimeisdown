---
import IcecastPlayer from "@/components/audio/IcecastPlayer";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title="Airshow" description="Listen to the Chicago Air and Water Show radio stream.">
  <div class="container">
    <h2>Chicago Air and Water Show radio</h2>
    <IcecastPlayer client:only="react" stream="https://icecast.crimeisdown.com/airshow" />
  </div>
</BaseLayout>

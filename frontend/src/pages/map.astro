---
import { MapLookupApp } from "@/components/area/MapLookupApp";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadRadioIds, loadUcrCodes } from "@/lib/reference/data";

export const prerender = true;

const radioIds = loadRadioIds();
const ucrCodes = loadUcrCodes();
---

<BaseLayout
  title="Incident Map"
  description="Look up a Chicago address to see neighborhoods, districts, wards, and recommended scanner channels."
>
  <div class="container-fluid">
    <MapLookupApp
      client:load
      radioIds={radioIds}
      ucrCodes={ucrCodes}
    />
  </div>
</BaseLayout>

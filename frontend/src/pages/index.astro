---
import HomeTranscriptSearch from "@/components/transcripts/HomeTranscriptSearch.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/home.css";

export const prerender = true;

const tools = [
  {
    name: "Chicago Map",
    href: "/map",
    image: "/img/incident_map.png",
    access: "Free",
    description: "Find an address’s neighborhood, police district, and scanner channel.",
    action: "Find an address",
  },
  {
    name: "Scanner Audio",
    href: "/audio",
    image: "/img/scanner_audio.png",
    access: "Free",
    description: "Listen to police and fire channels, or go back to a recording you missed.",
    action: "Listen or find recordings",
  },
  {
    name: "Scanner Transcripts",
    href: "/transcripts/search",
    image: "/img/transcript_search.png",
    access: "Patreon",
    description: "Find the dispatch you’re looking for without listening through hours of audio.",
    action: "Search transcripts",
  },
  {
    name: "Scanner Guide",
    href: "/guide",
    image: "/img/scanner_guide.png",
    access: "Free",
    description: "Look up the codes, radio IDs, and lingo you hear on the scanner.",
    action: "Read the guide",
  },
];
---

<BaseLayout
  title="CrimeIsDown.com"
  description="Find Chicago police and fire channels, search scanner transcripts, and revisit recordings. Try a free transcript demo for your area."
>
  <div class="container home-page">
    <header class="home-intro">
      <h1 id="title">Make sense of Chicago’s scanner traffic.</h1>
      <p>Find your local police and fire channels, search what was said, and go back to the recording.</p>
    </header>

    <HomeTranscriptSearch />

    <nav class="home-tools" aria-label="Scanner tools">
      {tools.map((tool) => (
        <a class="home-tool" href={tool.href}>
          <div class="home-tool-heading">
            <h2>{tool.name}</h2>
            <span class:list={["home-access", { "home-access-paid": tool.access === "Patreon" }]}>{tool.access}</span>
          </div>
          <img class="home-tool-image" src={tool.image} alt="" width="480" height="300" />
          <p class="home-tool-description">{tool.description}</p>
          <span class="home-tool-action">{tool.action} <span aria-hidden="true">&rarr;</span></span>
        </a>
      ))}
    </nav>

    <p class="home-audio-note">
      <svg class="cid-icon" aria-hidden="true"><use href="#cid-CircleInfo" /></svg>
      CPD zone feeds are delayed 30–35 minutes and open on Broadcastify.
      Recording download limits apply; Patreon members get higher limits.
    </p>

    <div class="home-details">
      <section class="home-section" id="about" aria-labelledby="about-crimeisdown">
        <h2 id="about-crimeisdown">About CrimeIsDown</h2>
        <p>A dispatch mentions a street, a unit, or a radio code. CrimeIsDown helps you put it in context, whether you’re reporting a story, following your neighborhood, or listening along.</p>
        <a class="home-text-link" href="/about">Our story, sources, and community <span aria-hidden="true">&rarr;</span></a>
        <p class="home-contact" id="contact-us">Need help? <a href="/support">Contact us</a> for website support and other questions.</p>
      </section>

      <section class="home-section" aria-labelledby="support-heading">
        <h2 id="support-heading">Go beyond the demo</h2>
        <p>Search current scanner transcripts by keyword, time, and channel, and revisit the recordings behind them. Choose a Patreon tier with transcript search to get started. Your support keeps the scanners and hosting running.</p>
        <div class="home-support-actions">
          <a class="btn btn-primary" href="https://www.patreon.com/EricTendian" target="_blank" rel="noopener noreferrer">See Patreon memberships</a>
          <a href="/support">Membership &amp; donation details <span aria-hidden="true">&rarr;</span></a>
        </div>
      </section>
    </div>

    <section class="home-section home-community" aria-labelledby="community-heading">
      <h2 id="community-heading">Follow the scanner community</h2>
      <p>Keep up with scanner listeners and local reporters, and explore the sources behind our tools.</p>
      <div class="home-community-links">
        <a href="https://twitter.com/EricTendian/lists/CrimeIsDown" target="_blank" rel="noopener noreferrer">#CrimeIsDown on X / Twitter <span aria-hidden="true">&nearr;</span></a>
        <a href="/about#about">About the community <span aria-hidden="true">&rarr;</span></a>
        <a href="/about#news-resources">News &amp; resources <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

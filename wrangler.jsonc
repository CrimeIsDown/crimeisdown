{
  "main": "dist/_worker.js/index.js",
  "name": "crimeisdown-v4",
  "compatibility_date": "2026-03-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}

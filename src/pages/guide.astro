---
import RadioIdLookup from "@/components/reference/RadioIdLookup";
import UcrCodeLookup from "@/components/reference/UcrCodeLookup";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { loadRadioIds, loadUcrCodes } from "@/lib/reference/data";

const radioIds = loadRadioIds();
const ucrCodes = loadUcrCodes();
---

<BaseLayout title="Scanner Guide" description="Use the original CrimeIsDown scanner guide and lookup tools.">
  <div class="container">
    <div class="row">
      <div class="col-sm-12 col-md-6">
        <RadioIdLookup client:load rows={radioIds} />
        <h4>Relevant links</h4>
        <ul>
          <li><a href="http://www.chicagofiremap.net/p/ems.html">EMS Triage Codes (Green/Yellow/Red/Black)</a></li>
          <li><a href="http://chicagoareafire.com/blog/wp-content/uploads/2016/05/Battalion-Map.pdf">CFD Fire Districts/Battalions map</a></li>
          <li><a href="http://chicagoareafire.com/blog/wp-content/uploads/2016/05/Field-Chief-Map.pdf">CFD EMS Districts map</a></li>
          <li><a href="https://en.wikipedia.org/wiki/Chicago_Fire_Department#Alarm_assignments">CFD Response Types</a> (<a href="https://news.wttw.com/sites/default/files/article/file-attachments/C.F.D._STRUCTURE_FIRE_ASSIGNMENTS_.pdf">additional info, may be outdated</a>)</li>
        </ul>
      </div>
      <div class="col-sm-12 col-md-6">
        <UcrCodeLookup client:load rows={ucrCodes} />
      </div>
    </div>

    <div class="row">
      <div class="col-sm-12">
        <h2>Scanner Guide</h2>
        <iframe
          id="scanner-guide"
          title="Scanner guide viewer"
          src="https://docs.google.com/document/d/e/2PACX-1vQ07P-9ZP8VoohZCQQlmjahhbmgMZ33z5PGeOkckPbG4KOzxWg9CIkGK2cxEzb3ql3ZfFKt7fSSkO6m/pub?embedded=true"
        ></iframe>
        <p>Or <a href="https://docs.google.com/document/d/1J09YjR3XaQqu1gIu1Oyz1lpRjr73NThK_fGb8D3wmsU/edit?usp=sharing">view on Google Docs</a></p>
      </div>
    </div>
  </div>
</BaseLayout>

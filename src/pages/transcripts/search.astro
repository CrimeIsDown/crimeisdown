---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DismissibleAlert from "@/components/layout/DismissibleAlert.astro";
import TranscriptSearch from "@/components/transcripts/TranscriptSearch.astro";
import "@/styles/transcript-search.css";
---
<BaseLayout title="Search Scanner Transcripts"><div class="container-fluid">
  <DismissibleAlert alertKey="scanner-transcript-disclaimer" type="warning">Disclaimer: Transcripts are generated by AI and are not guaranteed to be correct. This is an experimental project so not every transmission may be available.</DismissibleAlert>
  <TranscriptSearch map={false} />
</div></BaseLayout>
